# さくらのレンタルサーバ用 Apache 設定
# 文字コード指定
AddDefaultCharset UTF-8

# MIMEタイプの追加
AddType application/geo+json .geojson
AddType application/json .json

# ブラウザキャッシュの最適化 (mod_expires が有効な場合)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hours"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 months"
  ExpiresByType application/javascript "access plus 1 months"
  ExpiresByType application/geo+json "access plus 1 days"
  ExpiresByType application/json "access plus 1 days"
  ExpiresByType image/jpeg "access plus 1 months"
  ExpiresByType image/png "access plus 1 months"
  ExpiresByType image/svg+xml "access plus 1 months"
</IfModule>

# Gzip圧縮 (mod_deflate が有効な場合)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/geo+json
</IfModule>
